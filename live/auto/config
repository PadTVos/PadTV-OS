#!/bin/sh
set -eu
lb config noauto \
    --mode debian \
    --distribution trixie \
    --architectures amd64 \
    --binary-images iso-hybrid \
    --bootloaders "syslinux grub-efi" \
    --archive-areas "main contrib non-free-firmware" \
    --backports true \
    --firmware-chroot true \
    --firmware-binary true \
    --debian-installer false \
    --apt-recommends true \
    --iso-application PadTV \
    --iso-volume PADTV_03_CORE \
    --iso-publisher "PadTV Project" \
    --image-name padtv \
    --bootappend-live "boot=live components persistence noeject quiet splash loglevel=3 systemd.show_status=false rd.systemd.show_status=false vt.global_cursor_default=0 username=padtv hostname=padtv locales=cs_CZ.UTF-8 keyboard-layouts=cz timezone=Europe/Prague" \
    "$@"
