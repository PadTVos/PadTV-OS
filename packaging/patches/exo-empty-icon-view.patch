From 24b902eb389eecab7b3f8aaefdda4aff7608af9d Mon Sep 17 00:00:00 2001
From: Theo Linkspfeifer <lastonestanding@tutanota.com>
Date: Tue, 18 Feb 2025 07:49:25 +0100
Subject: [PATCH] Properly check iterator before usage (#124)

In order to prevent a possible crash which can occur when pressing 'END'
---
 exo/exo-icon-view.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/exo/exo-icon-view.c b/exo/exo-icon-view.c
index 25ec2ac5..1f037357 100644
--- a/exo/exo-icon-view.c
+++ b/exo/exo-icon-view.c
@@ -4761,7 +4761,7 @@ exo_icon_view_move_cursor_start_end (ExoIconView *icon_view,
     return;
   
   iter = (count < 0) ? g_sequence_get_begin_iter (icon_view->priv->items) : g_sequence_iter_prev (g_sequence_get_end_iter (icon_view->priv->items));
-  if (G_UNLIKELY (iter == NULL))
+  if (G_UNLIKELY (iter == NULL || g_sequence_iter_is_end (iter)))
     return;
 
   item = EXO_ICON_VIEW_ITEM (g_sequence_get (iter));
