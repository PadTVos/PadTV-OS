<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>PadTV</vendor>
  <action id="org.padtv.system.power">
    <description>Ovládání napájení PadTV</description>
    <message>Tato operace vyžaduje aktivní místní relaci PadTV.</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>no</allow_active></defaults>
  </action>
  <action id="org.padtv.system.services">
    <description>Správa podporovaných služeb PadTV</description>
    <message>Tato operace vyžaduje aktivní místní relaci PadTV.</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>no</allow_active></defaults>
  </action>
</policyconfig>
